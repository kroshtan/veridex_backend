# Copy to .env and fill in. Every setting in src/veridex/settings.toml can be
# overridden with a VERIDEX_-prefixed environment variable.

VERIDEX_OPENAI_API_KEY=sk-...
# Shared secret the web portal sends as X-Signup-Key when creating accounts.
VERIDEX_SIGNUP_SECRET=change-me

# Optional: Paddle billing
# VERIDEX_PADDLE_WEBHOOK_SECRET=
# VERIDEX_PADDLE_API_KEY=
# VERIDEX_PADDLE_ENVIRONMENT=sandbox
